{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pepo",
  "description": "Social intelligence for marketing teams, as an API and an MCP server.",
  "colors": {
    "primary": "#264548",
    "light": "#7FD4C8",
    "dark": "#1A2E30"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://pepo.ai"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "corpus",
              "brand-profile",
              "credits",
              "measurement"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json"
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Model Context Protocol",
            "pages": [
              "mcp/overview",
              "mcp/connect",
              "mcp/tools",
              "mcp/prompts"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@pepo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.pepo.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://pepo.ai"
    }
  }
}
